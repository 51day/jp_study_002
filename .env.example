# ============================================================
# MemorizeWord 环境变量模板
# 本地：复制为 .env 后填入真实值（.env 已在 .gitignore 中，永不入库）
# Vercel：在 Project → Settings → Environment Variables 逐条添加
# ============================================================

# ---------- 1. 访问控制（必填） ----------
# 进入 App 的全局密码。服务端用它派生会话签名密钥，
# 修改后所有已登录设备都需要重新登录。
ACCESS_PASSWORD="your-strong-password"

# ---------- 2. 数据库（多端同步，强烈建议） ----------
# Neon / Supabase / Vercel Postgres / 自建均可。不填则同步接口返回 503。
# ⚠️ Vercel 上请用 Neon 的「Pooled connection」(主机名带 -pooler)，
#    否则每个 Serverless 实例各开一条直连，容易打满 Neon 连接上限。
# ⚠️ 末尾保留 ?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# 兼容 Vercel Postgres 旧变量名，DATABASE_URL 存在时忽略此项
# POSTGRES_URL=""

# ---------- 3. AI API Key 加密（配置数据库时必填） ----------
# 用于 AES-256-GCM 加密存进数据库的第三方 AI Key。
# 必须是稳定的固定值：一旦更换，库里已加密的 Key 全部解不开，需重新填写。
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_CONFIG_ENCRYPTION_KEY="your-fixed-32-byte-hex-secret"

# ---------- 4. AI 服务商 Key（可只配其中一个） ----------
# 也可以不在这里配，改为登录后在「设置 → AI」界面里填（会加密存进数据库）
# GEMINI_API_KEY=""
# OPENAI_API_KEY=""
# DEEPSEEK_API_KEY=""

# ---------- 5. WebDAV 备份预设（可选） ----------
# 配置后，所有设备登录时自动带出网盘地址与账号，无需手动输入。
# 例如坚果云：https://dav.jianguoyun.com/dav/
# 例如 Koofr：https://app.koofr.net/dav/Koofr/
# WEBDAV_SERVER_URL=""
# WEBDAV_USERNAME=""
# WEBDAV_PASSWORD=""
# WEBDAV_REMOTE_PATH="/MemorizeWord/memorize_word_backup.json"

# ---------- 6. 站点地址（可选） ----------
# 用于生成自检链接与备份文件名，不影响核心功能。
# 部署到 Vercel 后填你的正式域名，如 https://memorize-word.vercel.app
APP_URL=""
